    "@xq/board": "workspace:*",
    "@xq/bots": "workspace:*",
    "@xq/content": "workspace:*",
    "@xq/engine": "workspace:*",
    "@xq/lessons": "workspace:*",
    "@xq/puzzles": "workspace:*",
    "idb-keyval": "^6.3.0",
    "xiangqi-core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
